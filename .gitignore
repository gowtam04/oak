# Dependencies
node_modules/
.pnp/
.pnp.*

# Build output
.next/
out/
dist/
build/

# TypeScript / Next generated artifacts
*.tsbuildinfo
next-env.d.ts

# Runtime data artifacts (built by `npm run ingest`)
# Anchored so it does NOT also ignore the web/src/data/ source dir.
web/data/
# Fandom wiki crawl cache (fetched by `npm run fetch:wiki`, NOT committed —
# multi-MB community prose; ingest reads it to build the wiki_page/wiki_chunk
# corpus). Regenerated on demand; absence just means an empty search_wiki.
web/.wiki-cache/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# TestFlight crash-log assets are committed on purpose (docs/testflight-feedback/)
!docs/testflight-feedback/assets/**/*.log

# Test / coverage
coverage/
.vitest/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
.cache/
