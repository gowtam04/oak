<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Backs ConnectivityObserver (Connectivity.kt, P11) — the app-wide offline
         banner reads ConnectivityManager.getActiveNetwork()/getNetworkCapabilities(),
         which throw a SecurityException without this permission (targetSdk 29+
         requires it explicitly; it is not implied by INTERNET). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".app.OakApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Oak"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name="ai.gowtam.oak.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Oak">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="oak.gowtam.ai" android:pathPrefix="/a/" />
            </intent-filter>
        </activity>

        <!--
          Backs the composer's camera-capture path (Composer.kt `launchCamera`):
          TakePicture() needs a content:// URI, not a raw file:// path, to hand to the
          system camera app. Scoped to the cache dir via res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
