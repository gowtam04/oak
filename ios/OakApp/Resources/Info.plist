<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Oak</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Brand typefaces (Google Fonts, OFL) bundled under Resources/Fonts/ and
	     registered here so `Font.custom` can resolve them by PostScript name:
	     Figtree (display/body), IBM Plex Mono (fact tables). The previous
	     Space Grotesk / Inter / JetBrains faces stay registered so leftover
	     OakChrome UIFont(name:) calls do not silently fall back. -->
	<key>UIAppFonts</key>
	<array>
		<string>Figtree-Regular.ttf</string>
		<string>Figtree-Medium.ttf</string>
		<string>Figtree-SemiBold.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
		<string>SpaceGrotesk-Medium.ttf</string>
		<string>SpaceGrotesk-SemiBold.ttf</string>
		<string>SpaceGrotesk-Bold.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>JetBrainsMono-Medium.ttf</string>
		<string>JetBrainsMono-SemiBold.ttf</string>
	</array>
	<!-- Portrait-only (iPhone, M-CON-2): a chat/team-builder UI that matches the
	     portrait App Store screenshots. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Usage strings (M-NFR-8): shown when the chat composer asks for camera /
	     photo-library access to attach images to a turn. -->
	<key>NSCameraUsageDescription</key>
	<string>Oak uses the camera so you can attach a photo to a question (for example, a screenshot or a card).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Oak uses your photo library so you can attach images to a question.</string>
	<!-- Shown when the composer's mic button starts voice mode (signed-in only). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Oak uses the microphone in voice mode so you can talk with the Pokédex assistant.</string>
	<!-- App Transport Security: defaults (HTTPS enforced; no arbitrary loads). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
